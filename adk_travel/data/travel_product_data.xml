<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
	<!-- Produits utilisés sur les lignes des factures générées à la confirmation d'une vente -->
	<record id="product_adk_travel_ticket" model="product.product">
		<field name="name">Billet de voyage</field>
		<field name="default_code">ADK-TICKET</field>
		<field name="type">service</field>
		<field name="sale_ok" eval="False"/>
		<field name="purchase_ok" eval="False"/>
		<field name="list_price">0.0</field>
		<!-- Aucune taxe par défaut : le prix du billet = le total de la facture. Ajoutez une taxe sur ce produit si votre activité y est soumise. -->
		<field name="taxes_id" eval="[(5, 0, 0)]"/>
	</record>
	<record id="product_adk_travel_baggage" model="product.product">
		<field name="name">Supplément bagages</field>
		<field name="default_code">ADK-BAGAGE</field>
		<field name="type">service</field>
		<field name="sale_ok" eval="False"/>
		<field name="purchase_ok" eval="False"/>
		<field name="list_price">0.0</field>
		<!-- Aucune taxe par défaut : le prix du billet = le total de la facture. Ajoutez une taxe sur ce produit si votre activité y est soumise. -->
		<field name="taxes_id" eval="[(5, 0, 0)]"/>
	</record>
</odoo>

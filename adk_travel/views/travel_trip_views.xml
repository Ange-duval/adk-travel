<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_travel_trip_list" model="ir.ui.view">
		<field name="name">adk.travel.trip.list</field>
		<field name="model">adk.travel.trip</field>
		<field name="arch" type="xml">
			<list string="Voyages" decoration-muted="state == 'cancelled'" decoration-info="state == 'in_progress'" decoration-success="state == 'done'">
				<field name="name"/>
				<field name="agency_id"/>
				<field name="line_id"/>
				<field name="vehicle_id"/>
				<field name="driver_id"/>
				<field name="departure_datetime"/>
				<field name="booked_seats"/>
				<field name="available_seats"/>
				<field name="fill_rate" widget="percentage"/>
				<field name="revenue_total" sum="Total"/>
				<field name="state" widget="badge"/>
			</list>
		</field>
	</record>

	<record id="view_travel_trip_form" model="ir.ui.view">
		<field name="name">adk.travel.trip.form</field>
		<field name="model">adk.travel.trip</field>
		<field name="arch" type="xml">
			<form string="Voyage">
				<header>
					<button name="action_confirm" string="Confirmer" type="object" class="btn-primary" invisible="state != 'draft'"/>
					<button name="action_start" string="Démarrer" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
					<button name="action_done" string="Terminer" type="object" class="btn-success" invisible="state != 'in_progress'"/>
					<button name="action_cancel" string="Annuler" type="object" invisible="state in ('done','cancelled')"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done"/>
				</header>
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="%(action_travel_booking)d" type="action" class="oe_stat_button" icon="fa-ticket"
							context="{'search_default_trip_id': id}">
							<field name="booked_seats" widget="statinfo" string="Places réservées"/>
						</button>
					</div>
					<div class="oe_title">
						<h1><field name="name" readonly="1"/></h1>
					</div>
					<group>
						<group>
							<field name="agency_id" options="{'no_create': True}"/>
							<field name="line_id"/>
							<field name="vehicle_id"/>
							<field name="driver_id"/>
							<field name="departure_datetime"/>
						</group>
						<group>
							<field name="capacity"/>
							<field name="booked_seats"/>
							<field name="available_seats"/>
							<field name="fill_rate" widget="percentage"/>
							<field name="revenue_total"/>
						</group>
					</group>
					<notebook>
						<page string="Passagers">
							<field name="booking_line_ids" readonly="1">
								<list>
									<field name="ticket_ref"/>
									<field name="passenger_name"/>
									<field name="seat_id"/>
									<field name="travel_class_id"/>
									<field name="amount_total"/>
									<field name="state" widget="badge"/>
								</list>
							</field>
						</page>
						<page string="Observations">
							<field name="notes"/>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="view_travel_trip_search" model="ir.ui.view">
		<field name="name">adk.travel.trip.search</field>
		<field name="model">adk.travel.trip</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="line_id"/>
				<field name="vehicle_id"/>
				<field name="driver_id"/>
				<filter string="Aujourd'hui" name="filter_today" domain="[('departure_datetime','&gt;=', context_today().strftime('%Y-%m-%d')), ('departure_datetime','&lt;', (context_today()+relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
				<filter string="Planifiés" name="filter_draft" domain="[('state','=','draft')]"/>
				<filter string="En route" name="filter_in_progress" domain="[('state','=','in_progress')]"/>
				<filter string="Terminés" name="filter_done" domain="[('state','=','done')]"/>
				<group expand="0" string="Regrouper par">
					<filter string="Agence" name="groupby_agency" context="{'group_by':'agency_id'}"/>
					<filter string="Ligne" name="groupby_line" context="{'group_by':'line_id'}"/>
					<filter string="Véhicule" name="groupby_vehicle" context="{'group_by':'vehicle_id'}"/>
					<filter string="Statut" name="groupby_state" context="{'group_by':'state'}"/>
					<filter string="Date de départ" name="groupby_date" context="{'group_by':'departure_datetime:day'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="view_travel_trip_calendar" model="ir.ui.view">
		<field name="name">adk.travel.trip.calendar</field>
		<field name="model">adk.travel.trip</field>
		<field name="arch" type="xml">
			<calendar date_start="departure_datetime" string="Voyages" color="vehicle_id" mode="week">
				<field name="line_id"/>
				<field name="vehicle_id"/>
			</calendar>
		</field>
	</record>

	<record id="action_travel_trip" model="ir.actions.act_window">
		<field name="name">Voyages</field>
		<field name="res_model">adk.travel.trip</field>
		<field name="view_mode">list,calendar,form</field>
	</record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_travel_cash_closing_list" model="ir.ui.view">
		<field name="name">adk.travel.cash.closing.list</field>
		<field name="model">adk.travel.cash.closing</field>
		<field name="arch" type="xml">
			<list string="Clôtures de Caisse" decoration-danger="amount_diff != 0" decoration-success="state == 'validated'">
				<field name="name"/>
				<field name="date"/>
				<field name="agency_id"/>
				<field name="guichetier_id"/>
				<field name="amount_expected"/>
				<field name="amount_counted"/>
				<field name="amount_diff"/>
				<field name="state" widget="badge"/>
			</list>
		</field>
	</record>

	<record id="view_travel_cash_closing_form" model="ir.ui.view">
		<field name="name">adk.travel.cash.closing.form</field>
		<field name="model">adk.travel.cash.closing</field>
		<field name="arch" type="xml">
			<form string="Clôture de Caisse">
				<header>
					<button name="action_validate" string="Valider la Clôture" type="object" class="btn-primary" invisible="state != 'draft'"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
				</header>
				<sheet>
					<div class="oe_title">
						<h1><field name="name" readonly="1"/></h1>
					</div>
					<group>
						<group>
							<field name="date"/>
							<field name="agency_id" options="{'no_create': True}"/>
							<field name="guichetier_id"/>
						</group>
						<group>
							<field name="amount_expected"/>
							<field name="amount_counted"/>
							<field name="amount_diff" class="fw-bold"/>
						</group>
					</group>
					<notebook>
						<page string="Ventes du jour">
							<field name="booking_ids" readonly="1">
								<list>
									<field name="name"/>
									<field name="client_name"/>
									<field name="trip_id"/>
									<field name="amount_total"/>
									<field name="payment_method_id"/>
									<field name="amount_paid"/>
								</list>
							</field>
						</page>
						<page string="Observations">
							<field name="notes"/>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="action_travel_cash_closing" model="ir.actions.act_window">
		<field name="name">Clôtures de Caisse</field>
		<field name="res_model">adk.travel.cash.closing</field>
		<field name="view_mode">list,form</field>
	</record>
</odoo>

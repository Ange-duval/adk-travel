<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_travel_employee_list" model="ir.ui.view">
		<field name="name">adk.travel.employee.list</field>
		<field name="model">adk.travel.employee</field>
		<field name="arch" type="xml">
			<list string="Équipe de l'agence">
				<field name="matricule"/>
				<field name="name"/>
				<field name="agency_id"/>
				<field name="function"/>
				<field name="phone"/>
				<field name="email"/>
				<field name="hire_date"/>
				<field name="active"/>
			</list>
		</field>
	</record>

	<record id="view_travel_employee_kanban" model="ir.ui.view">
		<field name="name">adk.travel.employee.kanban</field>
		<field name="model">adk.travel.employee</field>
		<field name="arch" type="xml">
			<kanban class="o_kanban_mobile">
				<field name="name"/>
				<field name="function"/>
				<field name="photo"/>
				<templates>
					<t t-name="card">
						<div class="d-flex p-2">
							<img t-att-src="kanban_image('adk.travel.employee', 'photo', record.id.raw_value)" alt="Photo" class="o_kanban_image rounded-circle me-3" style="width:48px;height:48px;"/>
							<div>
								<strong><field name="name"/></strong>
								<div class="text-muted"><field name="function"/></div>
							</div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="view_travel_employee_form" model="ir.ui.view">
		<field name="name">adk.travel.employee.form</field>
		<field name="model">adk.travel.employee</field>
		<field name="arch" type="xml">
			<form string="Employé">
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_view_trips" type="object" class="oe_stat_button" icon="fa-bus" invisible="function != 'chauffeur'">
							<field name="trip_count" widget="statinfo" string="Voyages"/>
						</button>
						<button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-ticket" invisible="function != 'guichetiere'">
							<field name="booking_count" widget="statinfo" string="Ventes"/>
						</button>
					</div>
					<field name="photo" widget="image" class="oe_avatar"/>
					<div class="oe_title">
						<h1><field name="name" placeholder="Nom complet"/></h1>
					</div>
					<group>
						<group>
							<field name="agency_id" options="{'no_create': True}"/>
							<field name="matricule"/>
							<field name="function"/>
							<field name="phone"/>
							<field name="email"/>
						</group>
						<group>
							<field name="hire_date"/>
							<field name="contract_ref"/>
							<field name="user_id"/>
							<field name="active"/>
						</group>
					</group>
					<group string="Informations Chauffeur" invisible="function != 'chauffeur'">
						<field name="license_number"/>
						<field name="license_expiry"/>
					</group>
					<notebook>
						<page string="Observations">
							<field name="notes"/>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="view_travel_employee_search" model="ir.ui.view">
		<field name="name">adk.travel.employee.search</field>
		<field name="model">adk.travel.employee</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="matricule"/>
				<field name="agency_id"/>
				<filter string="Chef d'agence" name="filter_chef" domain="[('function','=','chef_agence')]"/>
				<filter string="Guichetières" name="filter_guichet" domain="[('function','=','guichetiere')]"/>
				<filter string="Chauffeurs" name="filter_chauffeur" domain="[('function','=','chauffeur')]"/>
				<separator/>
				<filter string="Archivés" name="inactive" domain="[('active','=',False)]"/>
				<group expand="0" string="Regrouper par">
					<filter string="Agence" name="groupby_agency" context="{'group_by':'agency_id'}"/>
					<filter string="Fonction" name="groupby_function" context="{'group_by':'function'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="action_travel_employee" model="ir.actions.act_window">
		<field name="name">Équipe / Employés</field>
		<field name="res_model">adk.travel.employee</field>
		<field name="view_mode">list,kanban,form</field>
	</record>
</odoo>

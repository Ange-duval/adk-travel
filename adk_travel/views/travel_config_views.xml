<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- ==================== LIGNES / DESTINATIONS ==================== -->
	<record id="view_travel_line_list" model="ir.ui.view">
		<field name="name">adk.travel.line.list</field>
		<field name="model">adk.travel.line</field>
		<field name="arch" type="xml">
			<list string="Lignes / Destinations">
				<field name="name"/>
				<field name="origin"/>
				<field name="destination"/>
				<field name="distance_km"/>
				<field name="duration_hours"/>
				<field name="trip_count"/>
			</list>
		</field>
	</record>

	<record id="view_travel_line_form" model="ir.ui.view">
		<field name="name">adk.travel.line.form</field>
		<field name="model">adk.travel.line</field>
		<field name="arch" type="xml">
			<form string="Ligne / Destination">
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_view_trips" type="object" class="oe_stat_button" icon="fa-bus">
							<field name="trip_count" widget="statinfo" string="Voyages"/>
						</button>
					</div>
					<div class="oe_title">
						<h1><field name="name" placeholder="Ex: Douala - Yaoundé"/></h1>
					</div>
					<group>
						<group>
							<field name="origin"/>
							<field name="destination"/>
						</group>
						<group>
							<field name="distance_km"/>
							<field name="duration_hours"/>
							<field name="active"/>
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_travel_line" model="ir.actions.act_window">
		<field name="name">Lignes / Destinations</field>
		<field name="res_model">adk.travel.line</field>
		<field name="view_mode">list,form</field>
	</record>

	<!-- ==================== CLASSES DE VOYAGE ==================== -->
	<record id="view_travel_class_list" model="ir.ui.view">
		<field name="name">adk.travel.class.list</field>
		<field name="model">adk.travel.class</field>
		<field name="arch" type="xml">
			<list string="Classes de voyage">
				<field name="sequence" widget="handle"/>
				<field name="name"/>
				<field name="code"/>
				<field name="base_price"/>
				<field name="baggage_free_kg"/>
				<field name="baggage_price_per_kg"/>
				<field name="baggage_price_per_extra_item"/>
			</list>
		</field>
	</record>

	<record id="view_travel_class_form" model="ir.ui.view">
		<field name="name">adk.travel.class.form</field>
		<field name="model">adk.travel.class</field>
		<field name="arch" type="xml">
			<form string="Classe de voyage">
				<sheet>
					<div class="oe_title">
						<h1><field name="name" placeholder="Ex: VIP"/></h1>
					</div>
					<group>
						<group>
							<field name="code"/>
							<field name="base_price"/>
							<field name="active"/>
						</group>
						<group string="Bagages">
							<field name="baggage_free_kg"/>
							<field name="baggage_price_per_kg"/>
							<field name="baggage_price_per_extra_item"/>
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_travel_class" model="ir.actions.act_window">
		<field name="name">Classes de voyage</field>
		<field name="res_model">adk.travel.class</field>
		<field name="view_mode">list,form</field>
	</record>

	<!-- ==================== TYPES DE VÉHICULE ==================== -->
	<record id="view_travel_vehicle_type_list" model="ir.ui.view">
		<field name="name">adk.travel.vehicle.type.list</field>
		<field name="model">adk.travel.vehicle.type</field>
		<field name="arch" type="xml">
			<list string="Types de véhicule" editable="bottom">
				<field name="name"/>
				<field name="code"/>
				<field name="active"/>
			</list>
		</field>
	</record>

	<record id="action_travel_vehicle_type" model="ir.actions.act_window">
		<field name="name">Types de véhicule</field>
		<field name="res_model">adk.travel.vehicle.type</field>
		<field name="view_mode">list</field>
	</record>

	<!-- ==================== MODES DE PAIEMENT ==================== -->
	<record id="view_travel_payment_method_list" model="ir.ui.view">
		<field name="name">adk.travel.payment.method.list</field>
		<field name="model">adk.travel.payment.method</field>
		<field name="arch" type="xml">
			<list string="Modes de paiement" editable="bottom">
				<field name="name"/>
				<field name="journal_id" options="{'no_create': True}"/>
				<field name="active"/>
			</list>
		</field>
	</record>

	<record id="action_travel_payment_method" model="ir.actions.act_window">
		<field name="name">Modes de paiement</field>
		<field name="res_model">adk.travel.payment.method</field>
		<field name="view_mode">list</field>
	</record>
</odoo>

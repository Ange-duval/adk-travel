<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_traval_maintenance_list" model="ir.ui.view">
		<field name="name">adk.traval.maintenance.list</field>
		<field name="model">adk.traval.maintenance</field>
		<field name="arch" type="xml">
			<list string="Maintenance de la Flotte" decoration-danger="state == 'draft'" decoration-info="state == 'in_progress'" decoration-success="state == 'done'">
				<field name="name"/>
				<field name="agency_id"/>
				<field name="vehicle_id"/>
				<field name="maintenance_type"/>
				<field name="request_date"/>
				<field name="technician"/>
				<field name="cost"/>
				<field name="state" widget="badge"/>
			</list>
		</field>
	</record>

	<record id="view_traval_maintenance_form" model="ir.ui.view">
		<field name="name">adk.traval.maintenance.form</field>
		<field name="model">adk.traval.maintenance</field>
		<field name="arch" type="xml">
			<form string="Maintenance Véhicule">
				<header>
					<button name="action_report_panne" string="Signaler Panne" type="object" class="btn-danger" invisible="state != 'draft'"/>
					<button name="action_start" string="Démarrer l'intervention" type="object" class="btn-primary" invisible="state != 'draft'"/>
					<button name="action_done" string="Terminer" type="object" class="btn-success" invisible="state != 'in_progress'"/>
					<button name="action_cancel" string="Annuler" type="object" invisible="state in ('done','cancelled')"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
				</header>
				<sheet>
					<div class="oe_title">
						<h1><field name="name" readonly="1"/></h1>
					</div>
					<group>
						<group>
							<field name="vehicle_id"/>
							<field name="maintenance_type"/>
							<field name="request_date"/>
						</group>
						<group>
							<field name="technician"/>
							<field name="date_start"/>
							<field name="date_end"/>
							<field name="cost"/>
						</group>
					</group>
					<group string="Description">
						<field name="issue_description" nolabel="1"/>
					</group>
					<group string="Observations">
						<field name="notes" nolabel="1"/>
					</group>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="view_traval_maintenance_search" model="ir.ui.view">
		<field name="name">adk.traval.maintenance.search</field>
		<field name="model">adk.traval.maintenance</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="vehicle_id"/>
				<filter string="Déclarées" name="filter_draft" domain="[('state','=','draft')]"/>
				<filter string="En cours" name="filter_in_progress" domain="[('state','=','in_progress')]"/>
				<filter string="Terminées" name="filter_done" domain="[('state','=','done')]"/>
				<group expand="0" string="Regrouper par">
					<filter string="Agence" name="groupby_agency" context="{'group_by':'agency_id'}"/>
					<filter string="Véhicule" name="groupby_vehicle" context="{'group_by':'vehicle_id'}"/>
					<filter string="Type" name="groupby_type" context="{'group_by':'maintenance_type'}"/>
					<filter string="Statut" name="groupby_state" context="{'group_by':'state'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="action_traval_maintenance" model="ir.actions.act_window">
		<field name="name">Maintenance Flotte</field>
		<field name="res_model">adk.traval.maintenance</field>
		<field name="view_mode">list,form</field>
	</record>
</odoo>

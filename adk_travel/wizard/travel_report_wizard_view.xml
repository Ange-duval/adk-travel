<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_travel_report_wizard_form" model="ir.ui.view">
		<field name="name">adk.travel.report.wizard.form</field>
		<field name="model">adk.travel.report.wizard</field>
		<field name="arch" type="xml">
			<form string="Extraction des Rapports">
				<sheet>
					<group>
						<group string="Période">
							<field name="date_start"/>
							<field name="date_end"/>
							<field name="include_draft"/>
						</group>
						<group string="Regroupement et filtres">
							<field name="report_type"/>
							<field name="agency_id" options="{'no_create': True}"/>
							<field name="line_id"/>
							<field name="vehicle_id"/>
						</group>
					</group>
				</sheet>
				<footer>
					<button name="action_print_report" string="Générer Rapport PDF" type="object" class="oe_highlight"/>
					<button name="action_export_excel" string="Exporter Excel" type="object" class="btn-secondary"/>
					<button name="action_view_bookings" string="Voir les ventes" type="object" class="btn-secondary"/>
					<button string="Annuler" class="btn-secondary" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>

	<record id="action_travel_report_wizard" model="ir.actions.act_window">
		<field name="name">Rapport Périodique</field>
		<field name="res_model">adk.travel.report.wizard</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
	</record>
</odoo>

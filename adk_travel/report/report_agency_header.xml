<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- En-tête commun des documents : identité de l'AGENCE (et non du module).
	     Variables attendues : header_agency (adk.travel.agency, optionnel), header_name (texte). -->
	<template id="report_agency_header">
		<div class="row" style="border-bottom:2px solid #000; padding-bottom:10px; margin-bottom:12px;">
			<div class="col-3" t-if="header_agency and header_agency.logo">
				<img t-att-src="image_data_uri(header_agency.logo)" style="max-height:70px; max-width:100%;"/>
			</div>
			<div t-att-class="'col-9' if header_agency and header_agency.logo else 'col-12'">
				<h3 style="font-weight:bold; margin:0;"><span t-out="header_name"/></h3>
				<div t-if="header_agency" class="text-muted small">
					<div t-if="header_agency.full_address"><span t-out="header_agency.full_address"/></div>
					<div>
						<span t-if="header_agency.phone">Tél : <span t-out="header_agency.phone"/></span>
						<span t-if="header_agency.phone and header_agency.email"> — </span>
						<span t-if="header_agency.email"><span t-out="header_agency.email"/></span>
					</div>
					<div t-if="header_agency.registration_number">N° <span t-out="header_agency.registration_number"/></div>
				</div>
			</div>
		</div>
	</template>
</odoo>

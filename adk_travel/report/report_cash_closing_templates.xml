<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="action_report_cash_closing" model="ir.actions.report">
		<field name="name">Rapport de Clôture de Caisse</field>
		<field name="model">adk.travel.cash.closing</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">adk_travel.report_cash_closing_view</field>
		<field name="report_file">adk_travel.report_cash_closing_view</field>
		<field name="print_report_name">'Cloture_Caisse_%s' % (object.name)</field>
		<field name="binding_model_id" ref="model_adk_travel_cash_closing"/>
		<field name="binding_type">report</field>
	</record>

	<template id="report_cash_closing_view">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="o">
				<div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
					<div class="page" style="font-family:'Helvetica',sans-serif; color:#222;">
						<t t-call="adk_travel.report_agency_header">
							<t t-set="header_agency" t-value="o.agency_id"/>
							<t t-set="header_name" t-value="o.agency_id.name"/>
						</t>
						<h3 style="text-align:center; font-weight:bold;">
							Clôture de Caisse — <span t-field="o.name"/>
						</h3>
						<div class="row mt-3">
							<div class="col-6">
								<p><strong>Date :</strong> <span t-field="o.date"/></p>
								<p><strong>Guichetière / Vendeur :</strong> <span t-field="o.guichetier_id.name"/></p>
							</div>
							<div class="col-6 text-end">
								<p><strong>Statut :</strong> <span t-field="o.state"/></p>
							</div>
						</div>

						<table class="table table-sm table-bordered mt-3">
							<thead style="background-color:#f2f2f2;">
								<tr>
									<th>Vente</th>
									<th>Client</th>
									<th>Voyage</th>
									<th>Mode paiement</th>
									<th class="text-end">Montant</th>
									<th class="text-end">Encaissé</th>
								</tr>
							</thead>
							<tbody>
								<tr t-foreach="o.booking_ids" t-as="b">
									<td><span t-field="b.name"/></td>
									<td><span t-field="b.client_name"/></td>
									<td><span t-field="b.trip_id.name"/></td>
									<td><span t-field="b.payment_method_id.name"/></td>
									<td class="text-end"><span t-field="b.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
									<td class="text-end"><span t-field="b.amount_paid" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
								</tr>
							</tbody>
						</table>

						<div class="row mt-4" style="border-top:2px solid #000; padding-top:10px;">
							<div class="col-4 text-center">
								<strong>Montant encaissé attendu</strong><br/>
								<span t-field="o.amount_expected" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
							</div>
							<div class="col-4 text-center">
								<strong>Montant compté</strong><br/>
								<span t-field="o.amount_counted" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
							</div>
							<div class="col-4 text-center">
								<strong>Écart</strong><br/>
								<span t-field="o.amount_diff" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
							</div>
						</div>
					</div>
				</div>
			</t>
		</t>
	</template>
</odoo>

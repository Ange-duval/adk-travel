	<record id="rule_travel_vehicle_seat_agency" model="ir.rule">
		<field name="name">vehicle_seat : accès par agence</field>
		<field name="model_id" ref="model_adk_travel_vehicle_seat"/>
		<field name="domain_force">['|', ('vehicle_id.agency_id.user_ids', '=', False), ('vehicle_id.agency_id.user_ids', 'in', [user.id])]</field>
		<field name="groups" eval="[(4, ref('group_travel_user')), (4, ref('group_travel_chauffeur')), (4, ref('group_traval_maintenance_user'))]"/>
	</record>
	<record id="rule_travel_vehicle_seat_agency_admin" model="ir.rule">

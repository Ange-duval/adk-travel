	</record>

	<record id="rule_travel_trip_agency" model="ir.rule">
		<field name="name">trip : accès par agence</field>
		<field name="model_id" ref="model_adk_travel_trip"/>
		<field name="domain_force">['|', ('agency_id.user_ids', '=', False), ('agency_id.user_ids', 'in', [user.id])]</field>
